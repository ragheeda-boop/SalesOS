# ── Environment ──────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=salesos
POSTGRES_PASSWORD=salesos_dev_password
POSTGRES_DB=salesos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Neo4j ────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=salesos_neo4j_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Event bus (kafka optional — see docs/ops/RUNTIME_STACK.md) ─
EVENT_BUS_TYPE=in_memory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Meilisearch ──────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=salesos_meili_master_key_dev

# ── JWT / Security ──────────────────────────────────────────
SECRET_KEY=change-me-in-production-min-32-chars!!
JWT_SECRET_KEY=change-me-in-production-min-32-chars!!
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / ML ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Vercel AI Gateway (server-only; never NEXT_PUBLIC_)
# Static-key fallback when VERCEL_OIDC_TOKEN is unavailable (CI / non-Vercel).
# On Vercel deployments, OIDC is preferred; AI SDK reads this if set.
AI_GATEWAY_API_KEY=

# ── Notion ───────────────────────────────────────────────────
NOTION_TOKEN=

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GF_SECURITY_ADMIN_PASSWORD=salesos_grafana_dev

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
IMAGE_TAG=local
GIT_SHA=local

# ── CORS (FE may use localhost or 127.0.0.1) ──────────────────
ALLOWED_HOSTS=http://localhost:3000,http://127.0.0.1:3000

# ── Feature Flags ────────────────────────────────────────────
FEATURE_SEARCH_FUZZY_V2=false
FEATURE_CRM_KANBAN=false

# ── AI Copilot (disabled by default — GA honesty per AI_HONESTY.md) ──
# Enable ONLY after evidence validation:
#   - [ ] AI response quality measured (accuracy > 80%)
#   - [ ] User feedback loop operational
#   - [ ] Decision Platform audit trail complete
#   - [ ] Prompt injection protections verified
# FEATURE_AI_COPILOT=false

# ── R-14 Runtime Role ────────────────────────────────────────
APP_POSTGRES_USER=salesos_app
APP_POSTGRES_PASSWORD=salesos_app_dev_password

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_GROUP_ID=salesos-group

# ── JWKS ──────────────────────────────────────────────────────
# SALESOS_JWKS_KEY_DIR=/data/jwks
# SALESOS_JWKS_ALLOW_REGENERATE=true

# ── Grafana ───────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin

# ── Alerting ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/placeholder
ALERTMANAGER_EMAIL_TO=ops@salesos.com
ALERTMANAGER_EMAIL_FROM=alertmanager@salesos.com
ALERTMANAGER_SMTP_HOST=smtp.sendgrid.net
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USER=apikey
ALERTMANAGER_SMTP_PASSWORD=placeholder
PAGERDUTY_ROUTING_KEY=placeholder
