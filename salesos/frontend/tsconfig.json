{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@salesos/decision-platform": ["./packages/platform/decision/index.ts"],
      "@salesos/decision-platform/*": ["./packages/platform/decision/*"],
      "@salesos/widget-sdk": ["./packages/widget-sdk/src/index.ts"],
      "@salesos/widget-sdk/*": ["./packages/widget-sdk/src/*"]
    },
    "target": "ES2017"
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "e2e",
    "playwright.config.ts",
    "**/testing/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/tests/**",
    "**/contract-test-utils.ts",
    "jest.setup.ts",
    "jest.config.js",
    "jest.custom-environment.js",
    "jest.resolver.js"
  ]
}
