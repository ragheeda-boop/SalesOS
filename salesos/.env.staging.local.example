# =============================================================================
# SalesOS — LOCAL VIRTUAL STAGING env template (NOT cloud / VPS)
# =============================================================================
# Copy to: salesos/.env.staging.local  (gitignored; never commit filled secrets)
# Used by: infra/staging/docker-compose.staging-virtual.yml
#           scripts/staging-virtual-*.ps1
#
# Honesty:
#   - This is a LOCAL stand-in only. It does NOT unblock cloud staging GA.
#   - Values below are LOCAL-ONLY placeholders (not production secrets).
#   - Do not reuse these values on any shared / cloud host.
#
# Ports (host): API :8001  FE :3002  Postgres :5433  Redis :6380
# Compose project: salesos-staging-local
# =============================================================================

# ── Environment ──
SALESOS_ENV=staging-virtual-local
SALESOS_DEBUG=true
NODE_ENV=production
LOG_LEVEL=INFO

# ── Database (container-internal host "postgres"; host port 5433) ──
POSTGRES_USER=salesos
POSTGRES_PASSWORD=local_virtual_staging_pg_only_not_for_cloud
POSTGRES_DB=salesos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# R-14 remediation (docs/program/RISK_REGISTER.md): least-privilege runtime
# role, separate from the POSTGRES_USER owner/migration role above.
# Auto-provisioned by infra/docker/postgres/init/02-app-role.sql. Leaving
# APP_POSTGRES_PASSWORD unset falls back to the owner role (unprotected,
# not broken) — set it to activate RLS-enforced isolation.
APP_POSTGRES_USER=salesos_app
APP_POSTGRES_PASSWORD=salesos_app_dev_password   # default matches init-provisioned role; to use a unique password: ALTER ROLE salesos_app WITH PASSWORD '...' in Postgres first, then replace this value — see OPERATIONS_MANUAL.md §14 step 4

# ── Neo4j (NOT started in light virtual profile — password still required by Settings) ──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=local_virtual_staging_neo4j_unused

# ── Redis (container-internal; host port 6380) ──
REDIS_URL=redis://redis:6379/0

# ── Event bus (light profile — no Kafka) ──
EVENT_BUS_TYPE=in_memory

# ── Auth (LOCAL ONLY — regenerate if you share this machine; do not commit real secrets) ──
# Fixed local placeholders (>=32 chars) so tabletop is reproducible without openssl.
SECRET_KEY=local_virtual_staging_secret_key_do_not_use_elsewhere_32plus
JWT_SECRET_KEY=local_virtual_staging_jwt_secret_key_do_not_use_elsewhere_32
JWT_ALGORITHM=RS256
JWT_EXPIRATION_MINUTES=60

# ── Feature flags (GA honesty) ──
FEATURE_AI_COPILOT=false
DEMO_MODE=false

# ── Public URLs (virtual staging ports — NOT primary soak :8000/:3000) ──
NEXT_PUBLIC_API_URL=http://localhost:8001
SALESOS_API_URL=http://localhost:8001
API_URL=http://backend:8000
FRONTEND_URL=http://localhost:3002
ALLOWED_HOSTS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8001

# ── Images (override for deploy/rollback tabletop) ──
BACKEND_IMAGE=salesos-backend:latest
FRONTEND_IMAGE=salesos-frontend:local
