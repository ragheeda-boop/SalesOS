# SalesOS Environment
# Copy to .env and fill in secrets
# NEVER commit .env to version control

# Database
POSTGRES_USER=salesos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=salesos

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_PRODUCTION
NEO4J_MAX_CONNECTIONS=50
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_MAX_RETRIES=3

# Redis
REDIS_URL=redis://redis:6379/0

# Event bus — in_memory is GA-acceptable degraded; set kafka when required
EVENT_BUS_TYPE=in_memory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Observability (optional; no cloud vendor required)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_PASSWORD=admin

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://backend:8000
SALESOS_API_URL=http://localhost:8000
SALESOS_BASE_URL=http://localhost:8000
SALESOS_WS_URL=ws://localhost:8000

# JWT
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_rand_hex_32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=

# Sentry (optional)
SENTRY_DSN=

# Grafana (password set via environment or secrets manager — never hardcoded)

# Domain (production)
DOMAIN=localhost

# Backup (optional)
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
NOTIFY_WEBHOOK=
