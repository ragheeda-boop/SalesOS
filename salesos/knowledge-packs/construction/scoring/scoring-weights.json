          {
            "id": "risk_contractual",
            "name": "Contractual Risk",
            "ar_name": "المخاطر التعاقدية",
            "weight": 0.2,
            "scoring_rules": {
              "low_risk": 0.1,
              "medium_risk": 0.5,
              "high_risk": 0.9
            }
          },
          {
            "id": "risk_schedule",
            "name": "Schedule Risk",
            "ar_name": "مخاطر الجدول الزمني",
            "weight": 0.15,
            "scoring_rules": {
              "low_risk": 0.1,
              "medium_risk": 0.5,
              "high_risk": 0.9
            }
          },
          {
            "id": "risk_market",
            "name": "Market Risk",
            "ar_name": "مخاطر السوق",
