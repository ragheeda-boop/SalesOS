    "risk_tiers": {
      "low_risk": {"max_score": 30, "label": "منخفض المخاطر", "action": "bid"},
      "medium_risk": {"max_score": 60, "label": "متوسط المخاطر", "action": "conditional_bid"},
      "high_risk": {"max_score": 100, "label": "عالی المخاطر", "action": "no_bid"}
    },
    "thresholds": {
      "hot": 75,
      "warm": 45,
      "cold": 0,
      "min_confidence": 0.5
