# =============================================================================
# SalesOS Staging Environment Template
# =============================================================================
# Copy to .env.staging and fill in all CHANGE_ME values.
# NEVER commit .env.staging to version control.
#
# This file is used by: infra/staging/docker-compose.staging.yml
#
# How to generate secrets:
#   openssl rand -hex 32   -> JWT_SECRET
#   openssl rand -base64 24 -> POSTGRES_PASSWORD, NEO4J_PASSWORD
# =============================================================================

# ── Environment ──
SALESOS_ENV=staging
SALESOS_DEBUG=true
NODE_ENV=staging
LOG_LEVEL=DEBUG

# ── Database ──
POSTGRES_USER=salesos
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=salesos
DATABASE_URL=postgresql+asyncpg://salesos:${POSTGRES_PASSWORD}@postgres:5432/salesos

# R-14 remediation (docs/program/RISK_REGISTER.md): least-privilege runtime
# role, separate from POSTGRES_USER (which stays the owner/migration role).
# Auto-provisioned by infra/docker/postgres/init/02-app-role.sql. Leaving
# APP_POSTGRES_PASSWORD unset falls back to the owner role (unprotected,
# not broken) — set it to activate RLS-enforced tenant isolation.
APP_POSTGRES_USER=salesos_app
APP_POSTGRES_PASSWORD=salesos_app_dev_password   # default matches init-provisioned role; to use a unique password: ALTER ROLE salesos_app WITH PASSWORD '...' in Postgres first, then replace this value — see OPERATIONS_MANUAL.md §14 step 4

# ── PgBouncer ──
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_MAX_CLIENT_CONN=100
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ── Neo4j ──
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STAGING_NEO4J_PASSWORD
NEO4J_MAX_CONNECTIONS=50
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_MAX_RETRIES=3

# ── Redis ──
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_NUM_PARTITIONS=3
KAFKA_LOG_RETENTION_HOURS=168

# ── Authentication ──
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
SECRET_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
# Must be distinct from SECRET_KEY — Google OAuth token encryption
GOOGLE_ENCRYPTION_KEY=CHANGE_ME_RUN_openssl_rand_hex_32
# Optional previous key(s) for decrypt during rotation (comma-separated)
# GOOGLE_ENCRYPTION_KEY_PREVIOUS=
JWT_ALGORITHM=RS256
JWT_EXPIRATION_MINUTES=60

# ── AI / OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.1

# ── Feature Flags ──
FEATURE_SEARCH_HYBRID=true
FEATURE_ENTITY_RESOLUTION=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_DECISION_ENGINE=true
# GA honesty: keep AI copilot off unless evidence-validated (AI_HONESTY.md)
FEATURE_AI_COPILOT=false
DEMO_MODE=false

# ── Monitoring ──
# Grafana credentials set via environment or secrets manager
PROMETHEUS_RETENTION_DAYS=15
SENTRY_DSN=

# ── Domain / public URLs (replace localhost when VPS has a real hostname) ──
DOMAIN=CHANGE_ME_STAGING_HOSTNAME
# Example once DNS exists: https://staging-api.example.com / https://staging.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000

# ── Backup (optional — staging backups not required) ──
BACKUP_RETENTION_DAYS=7
S3_BUCKET=
NOTIFY_WEBHOOK=
HEALTHCHECK_URL=

# ── Docker Registry (used by infra/staging/docker-compose.staging.yml + deploy-staging.yml) ──
REGISTRY=ghcr.io
IMAGE_NAMESPACE=ragheeda-boop/salesos
IMAGE_TAG=staging

# ── SMTP / Email (use Mailpit or similar for staging) ──
SMTP_HOST=smtp.staging.local
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=staging@staging.local
SMTP_USE_TLS=false

# ── SSO / OIDC (use test OAuth app for staging) ──
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BURST=200

# ── CORS Origins ──
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Celery / Task Queue ──
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Audit Retention ──
AUDIT_RETENTION_DAYS=90
AUDIT_LOG_LEVEL=INFO

# ── Stripe (sandbox keys for staging) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Google API (encryption + connector) ──
GOOGLE_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Meilisearch ──
MEILI_MASTER_KEY=
MEILI_HOST=http://meilisearch:7700

# ── Integration Hub ──
INTEGRATION_HUB_ENCRYPTION_KEY=
IMAGE_TAG=staging
