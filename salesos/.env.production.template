# SalesOS Production Environment Variables
# Copy this file to .env.production on the VPS
#
# Quick start:
#   cp .env.production.template .env.production
#   Then edit all CHANGE_ME values below.
#
# Generate secure passwords:
#   openssl rand -hex 32   (for POSTGRES_PASSWORD, NEO4J_PASSWORD)
#   openssl rand -hex 64   (for JWT_SECRET_KEY)
#
# ─── Required: CHANGE ALL DEFAULT SECRETS ────────────────────
POSTGRES_PASSWORD=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME_REPLACE_WITH_128_HEX_CHARS_OPENSSL_RAND_HEX_64_FOR_512_BITS
DOMAIN=salesos.com              # ← change to your real domain

# ─── Database ────────────────────────────────────────────────
POSTGRES_USER=salesos
POSTGRES_DB=salesos

# Used by Alembic migrations (direct to postgres, not via pgbouncer):
DATABASE_URL=postgresql+asyncpg://salesos:${POSTGRES_PASSWORD}@postgres:5432/salesos

# R-14 remediation (docs/program/RISK_REGISTER.md): least-privilege runtime
# role used by the backend app, separate from POSTGRES_USER (which stays the
# owner/migration role). Auto-provisioned by
# infra/docker/postgres/init/02-app-role.sql. Leaving APP_POSTGRES_PASSWORD
# unset falls back to the owner role (unprotected, not broken) — set it to
# activate RLS-enforced tenant isolation in production.
APP_POSTGRES_USER=salesos_app
APP_POSTGRES_PASSWORD=salesos_app_dev_password   # default matches init-provisioned role; to use a unique password: ALTER ROLE salesos_app WITH PASSWORD '...' in Postgres first, then replace this value — see OPERATIONS_MANUAL.md §14 step 4

# ─── Neo4j ───────────────────────────────────────────────────
NEO4J_USER=neo4j

# ─── Redis ───────────────────────────────────────────────────
# In production set REDIS_PASSWORD and use:
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=CHANGE_ME              # openssl rand -hex 16

# ─── OpenAI (required for embeddings and copilot) ────────────
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Optional OpenAI-compatible shim. Leave empty in production (official OpenAI
# default). Dev/staging self-hosted FreeLLMAPI example: http://freellmapi:3001/v1
# FEATURE_AI_COPILOT stays false. Do not deploy FreeLLMAPI to Railway prod.
OPENAI_BASE_URL=

# ─── JWT ─────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.${DOMAIN}

# ─── Scraper API Keys (leave empty to use mock scrapers) ─────
BALADY_API_KEY=
TAQEEM_API_KEY=
NAJIZ_API_KEY=
REGA_API_KEY=
NCNP_API_KEY=

# ─── Notion (for data pipeline integration) ──────────────────
NOTION_TOKEN=

# ─── Observability ───────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_DSN=                     # https://xxx@sentry.io/xxx

# ─── SMTP (email notifications) ──────────────────────────────
SMTP_HOST=                          # e.g. smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@salesos.io

# ─── SSO / OAuth ─────────────────────────────────────────────
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=

# ─── Meilisearch ─────────────────────────────────────────────
MEILI_MASTER_KEY=CHANGE_ME          # openssl rand -hex 32
MEILI_URL=http://meilisearch:7700

# ─── Rate Limiting (requests per window) ─────────────────────
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_ANONYMOUS=20
RATE_LIMIT_SEARCH=30

# ─── Kafka (event bus) ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Optional: list of all brokers for clustered setups
# KAFKA_BROKERS=kafka-0:9092,kafka-1:9092,kafka-2:9092

# ─── Prometheus / Observability ───────────────────────────────
# Set to "true" to expose /metrics endpoint on the API server
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=9090
# Grafana admin credentials (for provisioning dashboards)
# GRAFANA_ADMIN_USER set via environment or secrets manager
# GRAFANA_ADMIN_PASSWORD set via environment or secrets manager
# ─── Feature Flags ───────────────────────────────────────────
FEATURE_SEARCH_FUZZY_V2=false
FEATURE_AI_COPILOT=false
FEATURE_CRM_KANBAN=false

# ─── Celery ──────────────────────────────────────────────────
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_RESULT_EXPIRES=86400

# ─── MCP Server (AI agent connectivity) ──────────────────────
MCP_API_KEY=CHANGE_ME                       # openssl rand -hex 32

# ─── LLM Defaults ───────────────────────────────────────────
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
