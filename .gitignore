# SalesOS Root .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
# Mypy incremental caches (local/CI variant dirs — never commit)
.mypy_cache/
.mypy_cache_*
*.egg
dist/
build/
*.pyc

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# PostgreSQL
pgdata/

# Coverage
htmlcov/
.coverage
coverage/

# Uploads
uploads/

# Design asset archives
*.zip

# Large data files (keep small samples only)
*.xlsx
*.csv
/output/
*.csv
*.pptx

# Docker
.docker/

# reports
scrubbing_report.txt
scraper.log

# Output
output/

# Engineering OS platform source (now a submodule in engineering-os/)
salesos-engineering-os/

# Engineering OS submodule
engineering-os

# OpenCode old configs
opencode.old.json
opencode.old*.json

# Agent-local settings (Claude/opencode)
.claude/

# Poetry local config (container-created)
salesos/backend/.config/

# Cursor IDE
.cursor/

# Security tools
.gitleaks.toml
# .trivyignore tracked after DEC-098 (named CVE-2024-23342 only)

# Engineering recovery docs (archived under archive/)
archive/

# Audit evidence (large, ~200+ JSON files)
docs/audit/ga-engineering-audit/evidence/

# Design screenshots
docs/design/salesos-v3/delivery/screenshots/

# Ad-hoc root scripts
scripts/backup.sh

# Temp data / generated
notion_push_state.json
recovered_contacts.json
audit_api_raw.json
tier1_status.json
tier1_status.txt
companies_list.txt
batch_list.txt
batches.txt
output_check.txt

# data directory (root + moved under packages/)
# The bare `data/` name also matches product routes at
# salesos/frontend/src/app/v3/data/. Re-include only that tree.
data/
!salesos/frontend/src/app/v3/data/
!salesos/frontend/src/app/v3/data/**
packages/data/

# Credential / sensitive files (not tracked, guard against accidental commit)
cookies.txt
login.json
railway-status.json

# Generated K8s configs (produced from templates at deploy time)
salesos/infra/k8s/configmap-generated.yaml
salesos/infra/k8s/secrets-generated.yaml
infra/k8s/configmap-generated.yaml
infra/k8s/secrets-generated.yaml

# Backup / temp artifacts
*.bak
*.bak?
tmp-*

# R-14 ops temp (may contain DB passwords — never commit)
salesos/backend/.tmp_r14*


# Soak / probe temp evidence (may contain live JWTs - never commit)
.tmp-*
.tmp_*
docs/audit/ga-engineering-audit/enterprise-audit-board/history/*/evidence/ops01-staging/

# Local CI / GHA failure dumps at repo root (may contain workspace/service IDs)
*_failure_context.txt
/[0-9]*.err
/[0-9]*_run.err
/[0-9]*_run_snippet.txt
/workflow-failure-snippet.txt
.vercel
.env*

# Secrets found untracked on 2026-09-25 (report 100) — never commit
salesos/infra/k8s/secrets.yaml
salesos/infra/monitoring/prometheus-token

# Generated / local-only artifacts (report 100)
#
# NOTE: the *.tsv rules below previously carried a trailing slash, which makes
# gitignore treat them as *directory* patterns. They never matched the actual
# files, so every migration-drill artifact below showed up as untracked and one
# `git add .` would have committed them. Keep these as plain file patterns.
salesos/backend/benchmarks/results/
salesos/frontend/node_modules.incomplete-*/
salesos/frontend/.codex-qa-src/
salesos/backend/source_table_counts.tsv
salesos/backend/target_table_counts.tsv
salesos/backend/live_table_counts.tsv
salesos/backend/backup_shape_columns.tsv
salesos/backend/backup_shape_indexes.tsv
salesos/backend/migrated_shape_columns.tsv
salesos/backend/migrated_shape_indexes.tsv
salesos/backend/alembic_restore_drill.list

# Data exports — contain real md_* rows (people, contacts, review candidates).
# salesos_test_export/ was only covered for *.dump, leaving ~40MB of CSV
# (incl. md_global_people.csv) untracked-but-committable.
salesos_test_export/

# Agent scratch output containing PII (full_name, email, phone, linkedin)
# for 1,114+ contact records, plus market/CEO decks. Never commit.
Claude outputs/

# Local-only working material
business/
salesos/backend/.cache/
salesos/backend/.local/

salesos/backend/outputs/

# JWKS signing keys (private) - never commit
salesos/backend/app/modules/identity/_keys/
