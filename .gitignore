# SalesOS Root .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
*.egg
dist/
build/
*.pyc

# Node
node_modules/
.next/
out/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# PostgreSQL
pgdata/

# Coverage
htmlcov/
.coverage
coverage/

# Uploads
uploads/

# Design asset archives
*.zip

# Large data files (keep small samples only)
*.xlsx
*.csv
/output/
*.csv
*.pptx

# Docker
.docker/

# reports
scrubbing_report.txt
scraper.log

# Output
output/

# Engineering OS platform source (now a submodule in engineering-os/)
salesos-engineering-os/

# Engineering OS submodule
engineering-os

# OpenCode old configs
opencode.old.json
opencode.old*.json

# Agent-local settings (Claude/opencode)
.claude/

# Poetry local config (container-created)
salesos/backend/.config/

# Cursor IDE
.cursor/

# Security tools
.gitleaks.toml
.trivyignore

# Engineering recovery docs (committed separately if needed)
engineering-recovery/

# Audit evidence (large, ~200+ JSON files)
docs/audit/ga-engineering-audit/evidence/

# Design screenshots
docs/design/salesos-v3/delivery/screenshots/

# Ad-hoc root scripts
scripts/backup.sh

# Temp data / generated
notion_push_state.json
recovered_contacts.json
audit_api_raw.json
tier1_status.json
tier1_status.txt
companies_list.txt
batch_list.txt
batches.txt
output_check.txt

# data directory
data/

# Credential / sensitive files (not tracked, guard against accidental commit)
cookies.txt
login.json
railway-status.json

# Generated K8s configs (produced from templates at deploy time)
salesos/infra/k8s/configmap-generated.yaml
salesos/infra/k8s/secrets-generated.yaml
infra/k8s/configmap-generated.yaml
infra/k8s/secrets-generated.yaml

# Backup / temp artifacts
*.bak
*.bak?
tmp-*

# R-14 ops temp (may contain DB passwords — never commit)
salesos/backend/.tmp_r14*

