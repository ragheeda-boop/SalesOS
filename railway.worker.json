{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway.celery"
  },
  "deploy": {
    "startCommand": "celery -A app.celery_app worker --loglevel=info --concurrency=2 --max-tasks-per-child=1000",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
