FROM python:3.12-slim AS builder

WORKDIR /app

# Build provenance — injected by CI (deploy.yml). Used by GET /version.
ARG BUILD_COMMIT=""
ARG BUILD_DATE=""
ARG BUILD_ID=""
ENV BUILD_COMMIT=$BUILD_COMMIT \
    BUILD_DATE=$BUILD_DATE \
    BUILD_ID=$BUILD_ID

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY salesos/backend/pyproject.toml .
COPY salesos/backend/alembic.ini .
COPY salesos/backend/app/ app/
COPY salesos/backend/domains/ domains/
COPY salesos/backend/intelligence/ intelligence/
COPY salesos/backend/runtime/ runtime/
COPY salesos/backend/sdk/ sdk/
COPY salesos/backend/modules/ modules/
COPY salesos/backend/design_tokens/ design_tokens/

RUN pip install --no-cache-dir .


FROM python:3.12-slim AS production

# Keep build provenance in the runtime image (ARG must be redeclared).
ARG BUILD_COMMIT=""
ARG BUILD_DATE=""
ARG BUILD_ID=""
ENV BUILD_COMMIT=$BUILD_COMMIT \
    BUILD_DATE=$BUILD_DATE \
    BUILD_ID=$BUILD_ID

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r salesos && useradd -r -g salesos -d /app -s /sbin/nologin salesos

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/app ./app
COPY --from=builder /app/domains ./domains
COPY --from=builder /app/intelligence ./intelligence
COPY --from=builder /app/runtime ./runtime
COPY --from=builder /app/sdk ./sdk
COPY --from=builder /app/modules ./modules
COPY --from=builder /app/design_tokens ./design_tokens
COPY --from=builder /app/alembic.ini .

RUN mkdir -p /data/jwks && chown -R salesos:salesos /app /data/jwks

USER salesos

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD sh -c "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"
